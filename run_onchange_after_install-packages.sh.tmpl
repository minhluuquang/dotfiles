#!/bin/bash
set -euo pipefail

# Ensure common paths are visible for command checks
export PATH="$HOME/.local/bin:$HOME/.bun/bin:$PATH"

# ── Native package manager ──
{{ if eq .chezmoi.os "darwin" -}}
brew update
{{   if .packages.darwin.brews -}}
brew install {{ range .packages.darwin.brews }}{{ . | quote }} {{ end }}
{{   end -}}
{{   if .packages.darwin.casks -}}
brew install --cask {{ range .packages.darwin.casks }}{{ . | quote }} {{ end }}
{{   end -}}
{{ end -}}

{{ if eq .chezmoi.os "linux" -}}
{{   if .packages.ubuntu.apt -}}
sudo apt update
sudo apt install -y {{ range .packages.ubuntu.apt }}{{ . | quote }} {{ end }}
{{   end -}}
{{ end -}}

# ── curl-based installs (only if not already present) ──
{{ if eq .chezmoi.os "linux" -}}
if ! command -v starship &>/dev/null; then
    curl -sS https://starship.rs/install.sh | sh -s -- -y
fi

if ! command -v mise &>/dev/null; then
    curl https://mise.run | sh
fi

if ! command -v bun &>/dev/null; then
    curl -fsSL https://bun.sh/install | bash
fi

if ! command -v deno &>/dev/null; then
    curl -fsSL https://deno.land/install.sh | sh
fi

if ! command -v zellij &>/dev/null; then
    curl -fsSL https://zellij.dev/install | sh
fi
{{ end -}}

# platform-agnostic curl installs
if ! command -v devbox &>/dev/null; then
    curl -fsSL https://get.jetify.com/devbox | bash
fi

# ── Install mise-managed tools (installs node → makes npm available) ──
if command -v mise &>/dev/null; then
    mise install
    export PATH="$HOME/.local/share/mise/shims:$PATH"
fi
# ── npm/bun global installs ──
if command -v npm &>/dev/null; then
    if ! command -v claude &>/dev/null; then
        npm install -g @anthropic-ai/claude-code
    fi
    if ! command -v codex &>/dev/null; then
        npm install -g @openai/codex
    fi
fi

if command -v bun &>/dev/null; then
    if ! command -v omp &>/dev/null; then
        bun install -g @oh-my-pi/pi-coding-agent
    fi
fi
