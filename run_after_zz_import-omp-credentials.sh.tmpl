#!/bin/bash
# Imports DeepSeek API key into OMP agent.db from the chezmoi-encrypted secrets file.
# Idempotent: runs on every apply, skips if already imported.
set -euo pipefail

SECRETS_SRC="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/dot_config/fish/encrypted_private_secrets.fish.age"
OMP_DB="$HOME/.omp/agent/agent.db"

# Requirements
if ! command -v python3 &>/dev/null; then
    echo "⚠ python3 not found — skipping OMP credential import"
    exit 0
fi
if [ ! -f "$SECRETS_SRC" ]; then
    echo "⚠ Encrypted secrets file not found — skipping OMP credential import"
    exit 0
fi
if ! command -v chezmoi &>/dev/null; then
    echo "⚠ chezmoi not found — skipping OMP credential import"
    exit 0
fi

# Extract key via chezmoi decrypt; pass to python3 via env var (not args) to avoid ps leak
OMP_DEEPSEEK_KEY=$(chezmoi decrypt "$SECRETS_SRC" 2>/dev/null | grep 'DEEPSEEK_API_KEY' | head -1 | sed 's/.*"\(.*\)".*/\1/')
if [ -z "$OMP_DEEPSEEK_KEY" ]; then
    echo "⚠ DEEPSEEK_API_KEY not found in encrypted secrets — skipping"
    exit 0
fi

# Only proceed if OMP has created agent.db with the auth_credentials table
if [ ! -f "$OMP_DB" ]; then
    echo "⏳ OMP agent.db not yet created — omp hasn't started, will retry on next apply"
    exit 0
fi

# Pass key via environment to avoid leaking in process args
export OMP_DEEPSEEK_KEY
python3 - <<'PYEOF'
import sqlite3, os, json, time

key = os.environ.get('OMP_DEEPSEEK_KEY', '')
if not key:
    print('⚠ OMP_DEEPSEEK_KEY env var empty — skipping')
    exit(0)

db_path = os.path.expanduser('~/.omp/agent/agent.db')

try:
    conn = sqlite3.connect(db_path)
    cur = conn.cursor()

    cur.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='auth_credentials'")
    if not cur.fetchone():
        print('⏳ auth_credentials table not yet created by OMP — will retry')
        conn.close()
        exit(0)

    cur.execute("SELECT COUNT(*) FROM auth_credentials WHERE provider='deepseek'")
    if cur.fetchone()[0] > 0:
        print('• DeepSeek credentials already exist in agent.db, skipping')
        conn.close()
        exit(0)

    now = int(time.time())
    data = json.dumps({'key': key})
    cur.execute(
        'INSERT INTO auth_credentials (provider, credential_type, data, created_at, updated_at) VALUES (?, ?, ?, ?, ?)',
        ('deepseek', 'api_key', data, now, now)
    )
    conn.commit()
    conn.close()
    print('✓ Imported DeepSeek API key into OMP agent.db')
except Exception as e:
    print(f'⚠ Failed to import DeepSeek key: {e}')
    exit(0)  # Don't fail chezmoi apply
PYEOF
