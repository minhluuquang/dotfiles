#!/bin/bash
# Imports OMP credentials from environment variables into agent.db
# Credentials come from secrets.fish (age-encrypted chezmoi file)
set -euo pipefail

OMP_DB="$HOME/.omp/agent/agent.db"
mkdir -p "$(dirname "$OMP_DB")"

# Source secrets if env vars not already set
if [ -z "${DEEPSEEK_API_KEY:-}" ] && [ -f "$HOME/.config/fish/secrets.fish" ]; then
    source <(grep -v '^#' "$HOME/.config/fish/secrets.fish" | sed 's/^set -gx //;s/"/\\"/g;s/^/export /')
fi

# ── DeepSeek API key ──
if [ -n "${DEEPSEEK_API_KEY:-}" ]; then
    EXISTS=$(sqlite3 "$OMP_DB" "SELECT COUNT(*) FROM auth_credentials WHERE provider='deepseek'" 2>/dev/null || echo 0)
    if [ "$EXISTS" = "0" ]; then
        NOW=$(date +%s)
        DATA=$(printf '{"key":"%s"}' "$DEEPSEEK_API_KEY")
        sqlite3 "$OMP_DB" <<SQL
CREATE TABLE IF NOT EXISTS auth_credentials (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    provider TEXT NOT NULL,
    credential_type TEXT NOT NULL,
    data TEXT NOT NULL,
    disabled_cause TEXT DEFAULT NULL,
    identity_key TEXT DEFAULT NULL,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER)),
    updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER))
);
INSERT INTO auth_credentials (provider, credential_type, data, created_at, updated_at)
VALUES ('deepseek', 'api_key', '$DATA', $NOW, $NOW);
SQL
        echo "✓ Imported DeepSeek API key"
    else
        echo "• DeepSeek credentials already exist, skipping"
    fi
else
    echo "⚠ DEEPSEEK_API_KEY not set — skipping"
fi
