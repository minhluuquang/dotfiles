#!/bin/bash
# Imports OMP credentials into agent.db from chezmoi-encrypted secrets file
# Only runs once on first apply — subsequent auth changes use omp login
set -euo pipefail

SECRETS_SRC="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}/dot_config/fish/encrypted_private_secrets.fish.age"
OMP_DB="$HOME/.omp/agent/agent.db"

# Requirements
if ! command -v sqlite3 &>/dev/null; then
    echo "⚠ sqlite3 not installed — skipping OMP credential import"
    exit 0
fi
if [ ! -f "$SECRETS_SRC" ]; then
    echo "⚠ Encrypted secrets not found — skipping OMP credential import"
    exit 0
fi

# Extract DEEPSEEK_API_KEY from the encrypted secrets file
DEEPSEEK_API_KEY=$(chezmoi decrypt "$SECRETS_SRC" 2>/dev/null | grep 'DEEPSEEK_API_KEY' | head -1 | sed 's/.*"\(.*\)".*/\1/')
if [ -z "$DEEPSEEK_API_KEY" ]; then
    echo "⚠ DEEPSEEK_API_KEY not found in encrypted secrets — skipping"
    exit 0
fi

# Ensure agent.db exists with auth_credentials table
mkdir -p "$(dirname "$OMP_DB")"
sqlite3 "$OMP_DB" <<'SQLEOF'
CREATE TABLE IF NOT EXISTS auth_credentials (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    provider TEXT NOT NULL,
    credential_type TEXT NOT NULL,
    data TEXT NOT NULL,
    disabled_cause TEXT DEFAULT NULL,
    identity_key TEXT DEFAULT NULL,
    created_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER)),
    updated_at INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER))
);
CREATE INDEX IF NOT EXISTS idx_auth_provider ON auth_credentials(provider);
CREATE TABLE IF NOT EXISTS auth_credential_blocks (
    credential_id INTEGER NOT NULL,
    provider_key TEXT NOT NULL,
    block_scope TEXT NOT NULL DEFAULT '',
    blocked_until_ms INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (credential_id, provider_key, block_scope)
);
SQLEOF

# Skip if DeepSeek credentials already exist
EXISTS=$(sqlite3 "$OMP_DB" "SELECT COUNT(*) FROM auth_credentials WHERE provider='deepseek';" 2>/dev/null || echo 0)
if [ "$EXISTS" -gt 0 ]; then
    echo "• DeepSeek credentials already exist in agent.db, skipping"
    exit 0
fi

# Import DeepSeek API key
NOW=$(date +%s)
sqlite3 "$OMP_DB" <<SQL
INSERT INTO auth_credentials (provider, credential_type, data, created_at, updated_at)
VALUES ('deepseek', 'api_key', '{"key":"$DEEPSEEK_API_KEY"}', $NOW, $NOW);
SQL
echo "✓ Imported DeepSeek API key into OMP agent.db"
